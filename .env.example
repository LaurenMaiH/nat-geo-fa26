DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here
DROPBOX_REFRESH_TOKEN=your_refresh_token_here

# Only used when running overnight_pipeline_optimized.py directly (not through the app),
# as the default Dropbox root folder for the hardcoded MISSION_ID at the top of that script.
# DROPBOX_DEPLOYMENT_ROOT=/DOEX0096_Palau

# ── Where Docker keeps large files (optional) ─────────────────────────────────
# If left unset, these default to folders inside the repo (./scratch, ./videos, ./model_cache).
# On Windows, point them at a drive with plenty of free space.
# Use FORWARD slashes (D:/PristineSeas/scratch), not backslashes. No quotes needed.
# Folders that don't exist yet are created automatically.

# Temporary working space: full-resolution video downloads, re-encoded copies, and
# review-player proxies while they're being made. Can grow to several times the size
# of the largest video; it's cleaned up automatically after each video.
# SCRATCH_DIR=D:/PristineSeas/scratch

# Folder holding local copies of mission videos (the container only reads from it).
# VIDEO_DIR=D:/PristineSeas/videos

# Downloaded model weights (~6 GB: YOLO-World, CLIP, fine-tuned BioCLIP, BioCLIP-2).
# Downloaded once on the first pipeline run, then reused every time.
# MODEL_DIR=D:/PristineSeas/model_cache

# ── Which processor runs the models (optional) ───────────────────────────────
# Leave unset to pick automatically: an NVIDIA GPU (cuda) if PyTorch can see one, then
# an Apple Silicon GPU (mps, only when running natively on a Mac, not in Docker), else
# the CPU. Set it to force one: cpu, cuda or mps. If the one you ask for isn't
# available, the pipeline stops with an error instead of silently using something slower.
# The device actually used is printed at the start of each run and saved in the
# mission's <mission>_run_log.json.
# INFERENCE_DEVICE=cpu

# GPU mode only (docker-compose.gpu.yml): which CUDA build of PyTorch to install.
# Default cu130 suits RTX 20-series and newer with a current driver; use cu126 for older GPUs.
# TORCH_CUDA_VARIANT=cu130
